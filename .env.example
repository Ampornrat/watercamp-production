# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it.

# =====================================================================
# Supabase — required for both client and server
# =====================================================================
# Get these from: Supabase Dashboard -> Project Settings -> API
# https://supabase.com/dashboard/project/_/settings/api

# Client-side (VITE_ prefix = baked into the browser bundle at build time)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# Server-side (used by SSR / server functions)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_OR_ANON_KEY"

# =====================================================================
# Optional: PORT/HOST for production runtime (Nitro node-server)
# Defaults are fine for local dev; set explicitly when deploying behind
# a reverse proxy that expects a specific port (e.g. PORT=8080 on OpenShift).
# =====================================================================
# PORT=3000
# HOST=0.0.0.0

# =====================================================================
# Email — Gmail SMTP (App Password)
# =====================================================================
# เปิด 2FA ก่อน แล้วไปสร้าง App Password ที่ myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="ศูนย์ฝึกอบรม คลังข้อมูลน้ำ <your-gmail@gmail.com>"
SITE_URL=https://your-domain.com

# =====================================================================
# File uploads — persistent storage path
# =====================================================================
# กำหนด path สำหรับเก็บไฟล์อัปโหลด (storyboard, VDO clip ฯลฯ)
# ถ้าไม่ตั้งค่า → ไฟล์จะถูกเก็บใน .output/public/uploads/ ซึ่งจะหายทุกครั้งที่ npm run build
# ตั้งเป็น path นอก project เพื่อให้ไฟล์คงอยู่แม้จะ build ใหม่
# UPLOAD_DIR=/var/watercamp/uploads
# (deprecated — ไฟล์อัปโหลดย้ายไป Google Drive แล้ว ไม่จำเป็นต้องตั้งค่านี้อีกต่อไป)

# =====================================================================
# Google Drive — file upload storage
# =====================================================================
# Folder ID จาก URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-folder-id

# Service Account key JSON (สำหรับ production / OpenShift)
# วิธีที่ 1: ใส่ JSON content ทั้งหมดในบรรทัดเดียว (escape double quotes)
# GOOGLE_SA_KEY_JSON={"type":"service_account","project_id":"..."}
# วิธีที่ 2: วางไฟล์ google-sa-key.json ไว้ที่ root ของ project (สำหรับ local dev เท่านั้น)
